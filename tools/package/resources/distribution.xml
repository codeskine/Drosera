<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Drosera</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <readme file="readme.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <allowed-os-versions>
        <os-version min="11.0"/>
    </allowed-os-versions>
    <choices-outline>
        <line choice="vst3"/>
        <line choice="au"/>
        <line choice="app"/>
    </choices-outline>
    <choice id="vst3" title="VST3" description="Drosera.vst3 in /Library/Audio/Plug-Ins/VST3" start_selected="true">
        <pkg-ref id="com.codeskine.drosera.vst3"/>
    </choice>
    <choice id="au" title="Audio Unit" description="Drosera.component in /Library/Audio/Plug-Ins/Components" start_selected="true">
        <pkg-ref id="com.codeskine.drosera.au"/>
    </choice>
    <choice id="app" title="Standalone" description="Drosera.app in /Applications" start_selected="true">
        <pkg-ref id="com.codeskine.drosera.app"/>
    </choice>
    <pkg-ref id="com.codeskine.drosera.vst3" version="@VERSION@">Drosera-VST3.pkg</pkg-ref>
    <pkg-ref id="com.codeskine.drosera.au" version="@VERSION@">Drosera-AU.pkg</pkg-ref>
    <pkg-ref id="com.codeskine.drosera.app" version="@VERSION@">Drosera-Standalone.pkg</pkg-ref>
</installer-gui-script>
